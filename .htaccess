# <IfModule mod_headers.c>
#     Header set Access-Control-Allow-Origin "*"
# </IfModule>

# # Hide a specific file
# <Files .env>
#     Order allow,deny
#     Deny from all
# </Files>

# <IfModule mod_rewrite.c>
#     Options -MultiViews
#     RewriteEngine On

#     # Redirect all requests to the Laravel front controller (server.php) except existing files or directories
#      RewriteCond %{REQUEST_FILENAME} !-d
#      RewriteCond %{REQUEST_FILENAME} !-f
#      RewriteRule ^ server.php [L]

#      DirectoryIndex server.php
# </IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Redirect from /ambulan-hebat/index.php to /ambulan-hebat
    RewriteCond %{REQUEST_URI} ^/ambulan-hebat/index\.php [NC]
    RewriteRule ^(.*)$ /ambulan-hebat [R=301,L]

    # Handle Laravel routing
    RewriteCond %{REQUEST_FILENAME} -d [OR]
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ ^$1 [N]

    RewriteCond %{REQUEST_URI} (\.\w+$) [NC]
    RewriteRule ^(.*)$ public/$1

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ server.php

</IfModule>


# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
